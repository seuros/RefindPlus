## @file
#
# iso9660.inf: Meridian's iso9660 filesystem driver. The shared fsw framework
# (core + EFI glue + utils) and all build options now live in
# FswFrameworkLib.inf and MeridianPkg.dsc; this driver supplies only its own
# source plus the fsw_active_fstype_table / _name bindings.
#
##

[Defines]
    INF_VERSION               = 0x00010005
    BASE_NAME                 = iso9660
    FILE_GUID                 = ff0c069a-8544-4535-b3c7-61fa106ab88d
    MODULE_TYPE               = UEFI_DRIVER
    EDK_RELEASE_VERSION       = 0x00020000
    EFI_SPECIFICATION_VERSION = 0x00010000
    VERSION_STRING            = 1.0
    ENTRY_POINT               = fsw_efi_main

#
# VALID_ARCHITECTURES = X64 AARCH64
#

[Sources]
    fsw_iso9660.c

[Packages]
    MdePkg/MdePkg.dec
    MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
    UefiDriverEntryPoint
    MemoryAllocationLib
    FswFrameworkLib
