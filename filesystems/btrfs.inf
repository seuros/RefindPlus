## @file
#
# btrfs.inf: Meridian's btrfs filesystem driver. The shared fsw framework
# (core + EFI glue + utils) and all build options now live in
# FswFrameworkLib.inf and MeridianPkg.dsc; this driver supplies only its own
# source plus the fsw_active_fstype_table / _name bindings.
#
##

[Defines]
    INF_VERSION               = 0x00010005
    BASE_NAME                 = btrfs
    FILE_GUID                 = 1388238d-a3f1-4f93-94c6-2fad8196e5d2
    MODULE_TYPE               = UEFI_DRIVER
    EDK_RELEASE_VERSION       = 0x00020000
    EFI_SPECIFICATION_VERSION = 0x00010000
    VERSION_STRING            = 1.0
    ENTRY_POINT               = fsw_efi_main

#
# VALID_ARCHITECTURES = X64 AARCH64
#

[Sources]
    fsw_btrfs.c

[Packages]
    MdePkg/MdePkg.dec
    MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
    UefiDriverEntryPoint
    MemoryAllocationLib
    FswFrameworkLib

# btrfs bundles scandisk.c, which references these standard protocol GUIDs by
# their global symbol (unlike the other drivers); declaring them here makes
# AutoGen emit the definitions into this module.
[Protocols]
    gEfiDiskIoProtocolGuid
    gEfiBlockIoProtocolGuid
