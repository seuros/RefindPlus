[Defines]
    INF_VERSION    = 0x00010006
    BASE_NAME      = LuaTest
    FILE_GUID      = 2B9F71C6-3A4D-4E18-9C2B-7F60A1D85E33
    MODULE_TYPE    = UEFI_APPLICATION
    VERSION_STRING = 1.0
    ENTRY_POINT    = UefiMain

[Sources]
    lua_test.c

[Packages]
    MdePkg/MdePkg.dec
    MeridianPkg/MeridianPkg.dec

[LibraryClasses]
    UefiApplicationEntryPoint
    UefiLib
    BaseLib
    LuaLib
