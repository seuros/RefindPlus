    UefiBootManagerLib
# For Debug logging ... Jief_Machak (sf.net/u/jief7/profile) from Clover
    MemLogLib
# For AcquireGOP
    HandleParsingLib
# Based on OcApfsLib from OpenCore
    MeridianApfsLib
# For SupplyNVME
    NvmExpressLib
    StateMachineLib



